% language
\RequirePackage[ngerman]{babel}
\RequirePackage[T1]{fontenc}

% math stuff
\RequirePackage{amsmath, amssymb, derivative, siunitx, wasysym, amsthm, mathtools}

% layout
\RequirePackage[left=2cm, right=2cm, head=18pt, top=2cm, bottom=2cm,includefoot=true]{geometry}
\RequirePackage{setspace}
\RequirePackage{changepage}
\RequirePackage{enumitem}
\RequirePackage{anyfontsize}

\setlength{\parindent}{0pt}

\RequirePackage{xcolor}

% commands, shortcuts and environments
\newenvironment{enumerateroman}{\begin{enumerate}[label=(\upshape\roman*)]}{\end{enumerate}}
\newcommand{\note}[1]{\textcolor{red}{\textbf{(#1)}}}
\newcommand{\prove}{\paragraph{Beweis}}

\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\K}{\mathbb{K}}
\newcommand{\C}{\mathbb{C}}
\renewcommand{\P}{\mathbb{P}}
\renewcommand{\Re}[1]{\operatorname{Re}(#1)}
\renewcommand{\Im}[1]{\operatorname{Im}(#1)}
\renewcommand{\mod}{\mathop{\mathrm{mod}}\ }
\let\oldexists\exists
\renewcommand{\exists}{\mathop{\oldexists}\nolimits}
\let\oldforall\forall
\renewcommand{\forall}{\mathop{\oldforall}\nolimits}
\let\oldvarphi\varphi
\let\oldphi\phi
\let\oldvarepsilon\varepsilon
\let\oldepsilon\epsilon
\renewcommand{\epsilon}{\oldvarepsilon}
\renewcommand{\phi}{\oldvarphi}
\renewcommand{\varepsilon}{\oldepsilon}
\renewcommand{\varphi}{\oldphi}

% amsthm-environments
\theoremstyle{definition}
\newtheorem{definition}{Definition}[section]
\newtheorem*{definition*}{Definition}
\newtheorem*{example}{Beispiel}

\theoremstyle{plain}
\newtheorem{theorem}{Satz}[section]
\newtheorem{lemma}{Lemma}
\counterwithin{lemma}{theorem} 

% colorboxes
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable}

% Hier definieren wir die 4 Grundfarben kurz und knackig
\definecolor{myBlue}{RGB}{41,128,185}
\definecolor{myRed}{RGB}{192,57,43}
\definecolor{myOrange}{RGB}{230,126,34}
\definecolor{myGreen}{RGB}{39,174,96}

\tcolorboxenvironment{definition}{
    enhanced, breakable, sharp corners, frame hidden, boxrule=0mm, before skip=10pt, after skip=10pt,
    borderline west={3pt}{0pt}{myBlue}, colback=myBlue!7!white
}
\tcolorboxenvironment{definition*}{
    enhanced, breakable, sharp corners, frame hidden, boxrule=0mm, before skip=10pt, after skip=10pt,
    borderline west={3pt}{0pt}{myBlue}, colback=myBlue!7!white
}
\tcolorboxenvironment{theorem}{
    enhanced, breakable, sharp corners, frame hidden, boxrule=0mm, before skip=10pt, after skip=10pt,
    borderline west={3pt}{0pt}{myRed}, colback=myRed!7!white
}
\tcolorboxenvironment{lemma}{
    enhanced, breakable, sharp corners, frame hidden, boxrule=0mm, before skip=10pt, after skip=10pt,
    borderline west={3pt}{0pt}{myRed}, colback=myRed!7!white
}
\tcolorboxenvironment{example}{
    enhanced, breakable, sharp corners, frame hidden, boxrule=0mm, before skip=10pt, after skip=10pt,
    borderline west={3pt}{0pt}{myGreen}, colback=myGreen!7!white
}


% refs and include
\RequirePackage{titlesec}
\RequirePackage{titletoc}

\titlecontents{part}
  [0em]                                  % Kein linker Einzug
  {\vspace{0.4ex}\bfseries}              % Deutlich kleinerer Abstand (0.4ex statt 1.5ex) und fette Schrift
  {\thecontentslabel\quad}               % Kompakte Nummerierung (z.B. "1 ")
  {}                                     % Wenn kein Label vorhanden ist
  {\titlerule*[0.5pc]{.}\contentspage}   % Engere Leader-Punkte und Seitenzahl rechtsbündig
  []     

\renewcommand{\part}[1]{%
  \clearpage
  \refstepcounter{part}%
  \addcontentsline{toc}{part}{#1}
}

\newcommand{\includemodule}[3]{
\clearpage
\pagestyle{empty}
\setcounter{section}{0}
\part{#2}
%modulename and teacher
{\Huge\bfseries #2}\\[0.3cm]
{\large\bfseries #3}
\vspace*{0.3cm}
\hrule
\startcontents[#1]
\printcontents[#1]{}{1}[2]{}
\clearpage
\pagestyle{scrheadings}
\setcounter{page}{1}
\input{#1}
\stopcontents[#1]


}

\newcommand{\makemaintitlepage}{
\pagestyle{empty}
{\centering
 \vspace*{2cm}
 {\Huge\bfseries\@title}
 \\[0.5cm]
 {\large \@author}
 
}     
